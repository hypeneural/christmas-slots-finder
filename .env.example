# WhatsApp Integration
# O destino do WhatsApp dos horarios selecionados e fixo em src/lib/slotWhatsApp.ts
# (SLOTS_WHATSAPP_NUMBER) e NAO e configuravel por ambiente nem pela API.
# VITE_WHATSAPP_URL e usado apenas pelos botoes gerais de contato.
VITE_WHATSAPP_URL=https://w.fotosdenatal.com/

# Payment Integration
VITE_PAYMENT_URL=https://evydencia.com/catalogo/natal

# External Links
VITE_SITE_PACKAGES_URL=https://fotosdenatal.com

# API Configuration (for future use)
VITE_USE_REAL_API=true
VITE_API_BASE_URL=https://evydencia.com/api/public/v1/agenda
VITE_AGENDA_CAMPAIGN_SLUG=natal
